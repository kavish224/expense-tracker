{
  "id": "/",
  "name": "Expenses",
  "short_name": "Expenses",
  "description": "Personal multi-account expense tracker",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0A0A0C",
